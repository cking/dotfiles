[include]
	path = config.local
[init]
	defaultBranch = trunk
[alias]
	ls = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate
	ll = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --numstat
	l = log --pretty=format:"%C(yellow)%h\\ %ad%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --date=short
	lr = log --pretty=format:"%C(yellow)%h\\ %ad%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --date=relative
	lg = log --graph --oneline
	cp = cherry-pick
	st = status -s
	s = status -sb
	cl = clone
	c = commit
	co = checkout
	br = branch
	bra = branch -a
	dfw = diff --word-diff
	dfc = diff --cached
	amend = commit --amend
	ci = commit --interactive
	a = add -p
	squash-all = "!f(){ git reset $(git commit-tree HEAD^{tree} -m \"${1:-A new start}\");};f"
	f = fetch
	fp = fetch --prune
	sw = show --format=fuller --stat --patch
	ri = rebase --interactive
	r = rebase
	prune = "!f(){ git fetch --prune origin && git branch --merged | grep -vwE 'main|master|trunk' | xargs git branch -d }; f"
	dlog = -c diff.external=difft log --ext-diff
	dshow = -c diff.external=difft show --ext-diff
	ddiff = -c diff.external=difft diff
	dl = dlog
	ds = dshow
	dft = ddiff
	logg = log --graph --decorate --oneline --all
	cm = commit
	dff = diff
	dfs = diff --staged
	pwl = push --with-lease
	oops = commit --amend --no-edit
	aliases = !git config --get-regexp alias | sed -re 's/alias\\.(\\S*)\\s(.*)$/\\1 = \\2/g'
	amend = commit --amend
	uncommit = reset --soft HEAD~1
	untrack = rm --cache --recursive --
	dam = diff ‐‐diff-algorithm=myers
	dap = diff ‐‐diff-algorithm=patience
	dah = diff ‐‐diff-algorithm=histogram
[format]
	pretty = "%H %ci %ce %ae %d %s"
[color]
	ui = auto
[core]
	editor = nvim
	autocrlf = input
	pager = delta
	whitespace = -trailing-space
[push]
	default = matching
	autoSetupRemote = true
	followtags = true
[commit]
	gpgsign = true
[gpg]
	program = gpg
[diff]
	noprefix = true
	colorMoved = default
	compactionHeuristic = true
	tool = difftastic
	colorMovedWS = allow-indentation-change
	context = 10
[cola]
	spellcheck = false
[color "diff"]
	commit = yellow reverse
[merge]
	log = true
	conflictStyle = zdiff3
	tool = nvimdiff
[mergetool]
	prompt = false
[difftool]
	prompt = false
[pager]
	difftool = true
[rebase]
	autosquash = true
	autostash = true
	missingCommitsCheck = error
	updateRefs = true
[tag]
	sort = version:refname
[gitflow "branch"]
	master = master
	develop = develop
[gitflow "prefix"]
	feature = feature/
	release = release/
	hotfix = hotfix/
	support = support/
	versiontag =
[pull]
	rebase = true
[credential]
	helper = /usr/lib/git-core/git-credential-libsecret
[interactive]
	diffFilter = delta --color-only
[delta]
	navvigate = true
[merge "mergiraf"]
    name = mergiraf
    driver = mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P
[difftool "difftastic"]
    cmd = difft "$MERGED" "$LOCAL" "abcdef1" "100644" "$REMOTE" "abcdef2" "100644"
[mergetool "nvimdiffx"]
    cmd = "nvim -d \"$LOCAL\" \"$REMOTE\" \"$MERGED\" -c 'wincmd w' -c 'wincmd J'"
[rerere]
	enabled = true
[help]
	autocorrect = 10
[fetch]
	prune = true
	prunetags = true
[log]
	date = iso
	abbrevCommit = true
[status]
	submoduleSummary = true
