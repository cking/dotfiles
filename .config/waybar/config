{
    "clock":
    {
        "calendar":
        {
            "format":
            {
                "days": "<span color='#ecc6d9'><b>{}</b></span>",
                "months": "<span color='#ffead3'><b>{}</b></span>",
                "today": "<span color='#ff6699'><b><u>{}</u></b></span>",
                "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                "weeks": "<span color='#99ffdd'><b>W{}</b></span>"
            },
            "mode": "year",
            "mode-mon-col": 3,
            "on-scroll": 1,
            "weeks-pos": "left"
        },
        "format": " {:%H:%M:%S}",
        "format-alt": " {:%Y-%m-%d}",
        "interval": 1,
        "on-click-right": "wl-copy $(date '+%Y-%m-%d %T')",
        "tooltip-format": "{calendar}"
    },
    "cpu":
    {
        "format": " {load} {usage}%",
        "on-click": "wezterm start htop"
    },
    "custom/lock":
    {
        "format": "󰍁",
        "on-click": "swaylock",
        "tooltip": false
    },
    "custom/power":
    {
        "format": "",
        "on-click": "systemctl shutdown",
        "tooltip": false
    },
    "custom/quit":
    {
        "format": "󰗼",
        "on-click": "hyprctl dispatch exit",
        "tooltip": false
    },
    "custom/reboot":
    {
        "format": "󰜉",
        "on-click": "systemctl reboot",
        "tooltip": false
    },
    "group/group-power":
    {
        "drawer":
        {
            "children-class": "not-power",
            "transition-duration": 500,
            "transition-left-to-right": false
        },
        "modules":
        [
            "custom/power",
            "custom/quit",
            "custom/lock",
            "custom/reboot"
        ],
        "orientation": "inherit"
    },
    "hyprland/submap":
    {
        "format": "[{}]",
        "max-length": 16,
        "tooltip": true
    },
    "hyprland/workspaces":
    {
        "all-outputs": false,
        "disable-scroll": true,
        "format": " {icon} {name} ",
        "format-icons":
        {
            "1": "",
            "1: Main": "",
            "2": "",
            "2: Web": "",
            "3": "",
            "3: Dev": "",
            "4": "",
            "4: Games": "",
            "5": "",
            "5: Misc": "",
            "6: Weeb": "",
            "7: DL": "",
            "8: IM": "",
            "9: Music": "",
            "activex": "",
            "default": "",
            "urgent": ""
        },
        "on-click": "activate",
        "show-special": true,
        "sort-by-number": true
    },
    "idle_inhibitor":
    {
        "format": "{icon}",
        "format-icons":
        {
            "activated": "",
            "deactivated": ""
        }
    },
    "keyboard-state":
    {
        "capslock": true,
        "format":
        {
            "capslock": " C {icon} ",
            "numlock": " N {icon} "
        },
        "format-icons":
        {
            "locked": "",
            "unlocked": ""
        },
        "numlock": true
    },
    "layer": "top",
    "memory":
    {
        "format": " {percentage}%"
    },
    "modules-center":
    [
        "hyprland/window"
    ],
    "modules-left":
    [
        "sway/workspaces",
        "hyprland/workspaces",
        "sway/mode",
        "hyprland/submap",
        "wlr/taskbar",
        "sway/window",
        "workspaces"
    ],
    "modules-right":
    [
        "privacy",
        "keyboard-state",
        "pulseaudio",
        "mpris",
        "network",
        "network#eth",
        "network#wlan",
        "cpu",
        "memory",
        "temperature",
        "battery",
        "idle_inhibitor",
        "clock",
        "tray",
    ],
    "mpris":
    {
        "dynamic-len": 50,
        "format": "{status_icon} {player_icon} {dynamic}",
        "format-stopped": "",
        "interval": 0.5,
        "player-icons":
        {
            "default": "🎵"
        },
        "status-icons":
        {
            "paused": "",
            "playing": ""
        }
    },
    "network":
    {
        "format-disconnected": "",
        "format-ethernet": " {ipaddr}",
        "format-wifi": " {ipaddr} ({signalStrength}%)",
        "interface": "*p*",
        "on-click": "wl-copy $(ip address show up scope global | grep inet | head -n1 | cut -d/ -f 1 | tr -d [:space:] | cut -c5-)",
        "on-click-right": "wl-copy $(ip address show up scope global | grep inet6 | head -n1 | cut -d/ -f 1 | tr -d [:space:] | cut -c6-)"
    },
    "network#eth":
    {
        "format-disconnected": "",
        "format-ethernet": " {ipaddr}",
        "format-wifi": " {ipaddr} ({signalStrength}%)",
        "interface": "eth*",
        "on-click": "wl-copy $(ip address show up scope global | grep inet | head -n1 | cut -d/ -f 1 | tr -d [:space:] | cut -c5-)",
        "on-click-right": "wl-copy $(ip address show up scope global | grep inet6 | head -n1 | cut -d/ -f 1 | tr -d [:space:] | cut -c6-)"
    },
    "network#wlan":
    {
        "format-disconnected": "",
        "format-ethernet": " {ipaddr}",
        "format-wifi": " {ipaddr} ({signalStrength}%)",
        "interface": "wl*",
        "on-click": "wl-copy $(ip address show up scope global | grep inet | head -n1 | cut -d/ -f 1 | tr -d [:space:] | cut -c5-)",
        "on-click-right": "wl-copy $(ip address show up scope global | grep inet6 | head -n1 | cut -d/ -f 1 | tr -d [:space:] | cut -c6-)"
    },
    "privacy":
    {
        "icon-size": 18,
        "icon-spacing": 4,
        "ignore":
        [
            {
                "name": "cava",
                "type": "audio-in"
            },
            {
                "name": "obs",
                "type": "screenshare"
            }
        ],
        "ignore-monitor": true,
        "modules":
        [
            {
                "tooltip": true,
                "tooltip-icon-size": 24,
                "type": "screenshare"
            },
            {
                "tooltip": true,
                "tooltip-icon-size": 24,
                "type": "audio-out"
            },
            {
                "tooltip": true,
                "tooltip-icon-size": 24,
                "type": "audio-in"
            }
        ],
        "transition-duration": 250
    },
    "pulseaudio":
    {
        "format": " {volume}%",
        "format-bluetooth": " {volume}% ",
        "format-icons":
        {
            "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
            "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
            "car": "",
            "default":
            [
                "",
                ""
            ],
            "hands-free": "",
            "headphone": "",
            "headset": "",
            "phone": "",
            "phone-muted": "",
            "portable": ""
        },
        "on-click": "pa-audio",
        "on-click-right": "pavucontrol",
        "scroll-step": 5
    },
    "sway/mode":
    {
        "format": "[{}]"
    },
    "sway/window":
    {
        "all-outputs": true,
        "format": " {}",
        "icon": false
    },
    "sway/workspaces":
    {
        "all-outputs": false,
        "disable-scroll": true,
        "format": " {icon} {name} ",
        "format-icons":
        {
            "1: Main": "",
            "2: Web": "",
            "3: Dev": "",
            "4: Games": "",
            "5: Misc": "",
            "6: Weeb": "",
            "7: DL": "",
            "8: IM": "",
            "9: Music": "",
            "active": "",
            "default": "",
            "urgent": ""
        }
    },
    "temperature":
    {
        "critical-threshold": 80,
        "format": " {temperatureC}°C",
        "format-critical": " {temperatureC}°C",
        "thermal-zone": "thermal_zone0"
    },
    "tray":
    {
        "icon-size": 16,
        "show-passive-items": true,
        "spacing": 10
    },
    "wlr/taskbar":
    {
        "on-click": "activate",
        "on-click-middle": "close"
    }
}
