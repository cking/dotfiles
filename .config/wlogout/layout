{
    "label" : "lock",
    "action" : "loginctl lock-session",
    "text" : "(L)ock",
    "keybind" : "l"
}
{
    "label" : "hibernate",
    "action" : "systemctl hibernate",
    "text" : "(H)ibernate",
    "keybind" : "h"
}
{
    "label" : "logout",
    "action" : "swaymsg exit; hyprctl dispatch exit; niri msg action quit -s",
    "text" : "(E)xit",
    "keybind" : "e"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "(S)hutdown",
    "keybind" : "s"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "text" : "S(u)spend",
    "keybind" : "u"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "(R)eboot",
    "keybind" : "r"
}
