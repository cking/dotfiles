// Globals
prefer-no-csd
screenshot-path "~/Pictures/Screenshots/%Y-%m-%d %H-%M-%S.png"

overview {
    backdrop-color "#777777"

    workspace-shadow {
        // SHADOW SETTINGS
    }
}

hotkey-overlay {
    skip-at-startup
}

// Input
cursor {
    hide-when-typing

    xcursor-theme "Sweet-cursors"
    xcursor-size 24
}

clipboard {
    disable-primary
}

gestures {
    hot-corners {
        off
    }
}

input {
    keyboard {
        track-layout "global"
        numlock
        xkb {
            layout "eu"
            options "compose:ralt,lv3:ralt_switch_multikey"
        }
    }

    focus-follows-mouse max-scroll-amount="0%"
    touchpad {
        tap
        dwt
        // dwtp
        drag true
        // drag-lock
        tap-button-map "left-right-middle"
        natural-scroll
        scroll-method "two-finger"
        click-method "clickfinger"
        disabled-on-external-mouse
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "no-scroll"
        // scroll-factor 0.2
    }

    mouse {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        scroll-button 274
        scroll-method "no-scroll"
        // scroll-factor 0.2
    }

    trackpoint {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "on-button-down"
        // scroll-button 273
        // scroll-button-lock
        // middle-emulation
    }

    tablet {
        map-to-output "HDMI-A-1"
    }

    workspace-auto-back-and-forth
    mod-key "Super"
    mod-key-nested "Alt"
}

// Output
// ultra wide
output "DP-1" {
    mode "3440x1440"
    variable-refresh-rate on-demand=true
    scale 1
    position x=0 y=0
    transform "normal"
    focus-at-startup
}

// vertical
output "DP-2" {
    mode "1920x1200"
    scale 1
    position x=-1200 y=-300
    transform "270"
}

animations {
    slowdown 0.2
}

layout {
    gaps 4
    center-focused-column "on-overflow"
    default-column-display "tabbed"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width {
        proportion 0.5;
    }

    border {
        off
    }

    focus-ring {
        width 2
        active-color "hsl(275, 75%, 60%)"
        inactive-color "hsl(275, 25%, 60%)"
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    tab-indicator {
        hide-when-single-tab
        width 8
        gap 4
        length total-proportion=1.0
        gaps-between-tabs 8
        position "left"
        corner-radius 4
        place-within-column
    }
}

workspace "Main"
workspace "Web" {
    open-on-output "DP-2"
}
workspace "Dev"
workspace "Games"
workspace "Misc"
workspace "Weeb"
workspace "DL"
workspace "IM" {
    open-on-output "DP-2"
}
workspace "Music"
workspace "Dunno"

// window rules
// Layer Shell: https://yalter.github.io/niri/Configuration%3A-Layer-Rules.html

window-rule {
    match at-startup=true app-id="librewolf"

    open-on-workspace "Web"
    open-maximized true
}

window-rule {
    match app-id="librewolf" title="Developer Tools -.*"
    match app-id="librewolf" title="Picture-in-Picture"
    match title="Steam - News.*"
    match title="(Open|Save) (File|Folder|As).*"

    open-floating true
}

window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#f38ba8"
        inactive-color "#7d0d2d"
    }

    border {
        inactive-color "#7d0d2d"
    }

    shadow {
        color "#7d0d2d70"
    }

    tab-indicator {
        active-color "#f38ba8"
        inactive-color "#7d0d2d"
    }
}

window-rule {
    match app-id="lutris"
    match title="Steam"

    open-maximized true
    open-on-workspace "Games"
}

window-rule {
    match title="Discord"
    match app-id="Dino"
    match app-id="Threema"
    match app-id="nheko"

    open-on-workspace "IM"
}

window-rule {
    match app-id="Supersonic"

    open-maximized true
    open-on-workspace "Music"
}

// events
switch-events {
    lid-close {
        spawn "notify-send" "lid-close"
    }

    lid-open {
        spawn "notify-send" "lid-open"
    }

    tablet-mode-on {
        spawn "notify-send" "tablet on"
    }

    tablet-mode-off {
        spawn "notify-send" "tablet off"
    }
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+Return hotkey-overlay-title="Terminal" { spawn "kitty"; }

    Mod+D hotkey-overlay-title="App launcher" { spawn "fuzzel"; }
    Mod+Shift+D hotkey-overlay-title="App drawer" { spawn "nwg-drawer" "-open"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }

    Mod+O repeat=false { toggle-overview; }
    Mod+Shift+Q repeat=false { close-window; }

    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-or-workspace-down; }
    Mod+Up    { focus-window-or-workspace-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-or-workspace-down; }
    Mod+K     { focus-window-or-workspace-up; }
    Mod+L     { focus-column-right; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+J     { move-window-down; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+L     { move-column-right; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    Mod+Ctrl+Left  { focus-monitor-left; }
    Mod+Ctrl+Down  { focus-monitor-down; }
    Mod+Ctrl+Up    { focus-monitor-up; }
    Mod+Ctrl+Right { focus-monitor-right; }
    Mod+Ctrl+H     { focus-monitor-left; }
    Mod+Ctrl+J     { focus-monitor-down; }
    Mod+Ctrl+K     { focus-monitor-up; }
    Mod+Ctrl+L     { focus-monitor-right; }

    // Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    // Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    // Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    // Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    // Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    // Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    // Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    // Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    // Mod+Shift+Ctrl+Left  { move-window-to-monitor-left; }
    // Mod+Shift+Ctrl+Down  { move-window-to-monitor-down; }
    // Mod+Shift+Ctrl+Up    { move-window-to-monitor-up; }
    // Mod+Shift+Ctrl+Right { move-window-to-monitor-right; }
    // Mod+Shift+Ctrl+H     { move-window-to-monitor-left; }
    // Mod+Shift+Ctrl+J     { move-window-to-monitor-down; }
    // Mod+Shift+Ctrl+K     { move-window-to-monitor-up; }
    // Mod+Shift+Ctrl+L     { move-window-to-monitor-right; }

    Mod+Shift+Ctrl+Left  { move-workspace-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-workspace-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-workspace-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-workspace-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-workspace-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-workspace-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-workspace-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-workspace-to-monitor-right; }

    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }

    // Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    // Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    // Mod+Ctrl+U         { move-column-to-workspace-down; }
    // Mod+Ctrl+I         { move-column-to-workspace-up; }

    Mod+Ctrl+Page_Down { move-window-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-window-to-workspace-up; }
    Mod+Ctrl+U         { move-window-to-workspace-down; }
    Mod+Ctrl+I         { move-window-to-workspace-up; }

    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }

    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Shift+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Shift+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Shift+WheelScrollRight { move-column-right; }
    Mod+Shift+WheelScrollLeft  { move-column-left; }

    Mod+Ctrl+WheelScrollDown      { focus-column-right; }
    Mod+Ctrl+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // Similarly, you can bind touchpad scroll "ticks".
    // Touchpad scrolling is continuous, so for these binds it is split into
    // discrete intervals.
    // These binds are also affected by touchpad's natural-scroll, so these
    // example binds are "inverted", since we have natural-scroll enabled for
    // touchpads by default.
    // Mod+TouchpadScrollDown { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.02+"; }
    // Mod+TouchpadScrollUp   { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.02-"; }

    Mod+1 { focus-workspace "Main"; }
    Mod+2 { focus-workspace "Web"; }
    Mod+3 { focus-workspace "Dev"; }
    Mod+4 { focus-workspace "Games"; }
    Mod+5 { focus-workspace "Misc"; }
    Mod+6 { focus-workspace "Weeb"; }
    Mod+7 { focus-workspace "DL"; }
    Mod+8 { focus-workspace "IM"; }
    Mod+9 { focus-workspace "Music"; }
    Mod+0 { focus-workspace "Dunno"; }

    // Mod+Shift+1 { move-column-to-workspace "Main"; }
    // Mod+Shift+2 { move-column-to-workspace "Web"; }
    // Mod+Shift+3 { move-column-to-workspace "Dev"; }
    // Mod+Shift+4 { move-column-to-workspace "Games"; }
    // Mod+Shift+5 { move-column-to-workspace "Misc"; }
    // Mod+Shift+6 { move-column-to-workspace "Weeb"; }
    // Mod+Shift+7 { move-column-to-workspace "DL"; }
    // Mod+Shift+8 { move-column-to-workspace "IM"; }
    // Mod+Shift+9 { move-column-to-workspace "Music"; }
    // Mod+Shift+0 { move-column-to-workspace "Dunno"; }

    Mod+Shift+1 { move-window-to-workspace "Main"; }
    Mod+Shift+2 { move-window-to-workspace "Web"; }
    Mod+Shift+3 { move-window-to-workspace "Dev"; }
    Mod+Shift+4 { move-window-to-workspace "Games"; }
    Mod+Shift+5 { move-window-to-workspace "Misc"; }
    Mod+Shift+6 { move-window-to-workspace "Weeb"; }
    Mod+Shift+7 { move-window-to-workspace "DL"; }
    Mod+Shift+8 { move-window-to-workspace "IM"; }
    Mod+Shift+9 { move-window-to-workspace "Music"; }
    Mod+Shift+0 { move-window-to-workspace "Dunno"; }

    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Mod+W { toggle-column-tabbed-display; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    // Mod+Shift+R { switch-preset-window-height; }
    // Mod+Ctrl+R { reset-window-height; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-width "-5%"; }
    Mod+Shift+Equal { set-window-width "+5%"; }

    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    Mod+Z allow-inhibiting=false { spawn "wlogout"; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    Ctrl+Alt+Delete { quit; }
    Mod+Shift+P { power-off-monitors; }
}

spawn-at-startup "qs" "-c" "noctalia-shell"
spawn-at-startup "nwg-drawer" "-ovl" "-r" "-k"
spawn-at-startup "wl-clip-persist"
spawn-sh-at-startup "swayidle -w timeout 300 '~/.config/sway/lock' timeout 600 'niri msg action power-off-monitors' resume 'niri msg action power-on-monitors' timeout 1800 'systemctl suspend' before-sleep '~/.config/sway/lock' lock '~/.config/sway/lock'"
